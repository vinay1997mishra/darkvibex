{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darkvibex-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../owner_panel",
    "binding": "ASSETS",
    "run_worker_first": true
  }

  // Existing Cloudflare resources must use these binding names:
  //   DB    -> darkvibex-db
  //   FILES -> darkvibex-files
  // OWNER_ADMIN_TOKEN must be stored as a Worker secret, never committed.
}
