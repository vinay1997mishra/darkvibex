{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "darkvibex-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "../owner_panel",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "darkvibex-db",
      "database_id": "008b5aec-c32e-4264-b8da-0c84a7ab3366"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "darkvibex-files"
    }
  ]

  // Store these only as Cloudflare Worker secrets/vars, never in Git:
  //   OWNER_ADMIN_TOKEN
  //   SESSION_SECRET
  //   LIVEKIT_URL
  //   LIVEKIT_API_KEY
  //   LIVEKIT_API_SECRET
  //   GOOGLE_WEB_CLIENT_ID
}
